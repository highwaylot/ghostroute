{
  "trailingSlash": false,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/css",
      "destination": "/css/website",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/html/website/:path+",
      "destination": "/app-shell"
    },
    {
      "source": "/html/email/:path+",
      "destination": "/app-shell"
    },
    {
      "source": "/css/website/:path+",
      "destination": "/app-shell"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
